// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" 
}

model Candidate {
  id            String   @id @default(uuid())
  fullName      String
  dob           String
  gender        String
  cccd          String
  phone         String
  email         String
  school        String
  province      String
  grade         String
  className     String
  studentId     String?
  table         String
  achievements  String?
  
  // File paths
  cccdPath      String?  // Ảnh mặt trước
  cccdBackPath  String?  // Ảnh mặt sau (MỚI THÊM)
  studentCardPath String?

  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model Contact {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  subject   String   // Chủ đề cần hỗ trợ
  message   String
  status    String   @default("UNREAD") // UNREAD, READ
  createdAt DateTime @default(now())
}